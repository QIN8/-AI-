# SQLite 路径。本地开发用相对 prisma 目录的文件；Docker 见 docker-compose.yml
DATABASE_URL="file:./dev.db"

# 站点展示名（可选）
NEXT_PUBLIC_SITE_NAME="三角洲资料站"

# 物价同步：过期后才向公开源请求（默认 8 分钟，勿在每个 HTML 渲染里直拉）
PRICE_SYNC_TTL_MS=480000

# 可选。Orzice 工作台/开放平台是 token 计费接口，没有公开免登录全量价。
# 不填则只用 GitHub 公开转储 + 本地 prisma/data/orzice-price.json。
# 申请：https://orzice.com/work/  （本站与其无合作关系）
# ORZICE_TOKEN=
# ORZICE_WORK_API_URL=https://orzice.com/workApi/v1/sjz_api/item_price_all

# Next.js
PORT=3000
NODE_ENV=production
